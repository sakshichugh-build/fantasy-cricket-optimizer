# ---- Supabase ----
# Project URL and publishable (anon) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY. Never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Gemini (all AI tasks) ----
GEMINI_API_KEY=
# Current Gemini Flash model id (verify against docs).
GEMINI_MODEL=gemini-2.5-flash

# ---- Cricket data (CricketData.org / CricAPI) ----
CRICKET_API_KEY=
