# ---- Supabase ----
# Project URL and publishable (anon) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY. Never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Gemini (all AI tasks) ----
GEMINI_API_KEY=
# Current Gemini Flash model id. As of Oct 2026, gemini-2.5-flash is retired for
# new accounts; gemini-3.8-flash is the current Flash model.
GEMINI_MODEL=gemini-3.8-flash

# ---- Cricket data (CricketData.org / CricAPI) ----
CRICKET_API_KEY=
